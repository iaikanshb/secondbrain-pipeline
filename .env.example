# Copy this file to .env and edit it -- it's auto-loaded by config.py (and
# by the systemd service via EnvironmentFile=), so no manual sourcing is
# required, though `set -a; source .env; set +a` still works too if you
# prefer that for a one-off manual run.

# Optional when a local gemini-keys.txt/gemini_keys.txt file is present.
GEMINI_API_KEY=your_gemini_api_key_here

# Obsidian vault location.
SECONDBRAIN_VAULT=~/Documents/second-brain

# Optional: any OpenAI-compatible embeddings endpoint (local llama.cpp,
# Ollama, a cloud provider). Enables semantic search (search.py) and a
# stronger duplicate-catch in dedupe.py. Everything degrades gracefully
# and works exactly the same without this set.
EMBEDDING_URL=
EMBEDDING_API_KEY=
