# Copy this file to .env, edit it, then run:
#   set -a; source .env; set +a

# Optional when a local gemini-keys.txt/gemini_keys.txt file is present.
GEMINI_API_KEY=your_gemini_api_key_here

# Obsidian vault location.
SECONDBRAIN_VAULT=~/Documents/second-brain

# Optional backward-compatible key-file source.
SECONDBRAIN_KEYFILE=~/llmstack/config/cloud-keys.env
